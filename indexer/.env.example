# The indexer reads MONAD_RPC_URL from the environment (run it via `npm run indexer:dev` at the repo root,
# which loads the root .env.local). Nothing needs to live in this file today.
# Optional, once an Envio API token exists (https://envio.dev/app/api-tokens): switch config.yaml to HyperSync.
ENVIO_API_TOKEN=
