# Copy to .env.local and fill in. Every value here is blank on purpose.
# .env.local is gitignored and holds the real values. Never copy a real value into this file.

# --- Supabase ---
# The browser gets no Supabase connection. No anon key, no client-side Supabase SDK.
# Every query is server-side over DATABASE_URL.
# DATABASE_URL is the transaction pooler string (port 6543). The app refuses the session string:
# the session pooler admits fifteen clients in total, which three serverless instances exhaust.
# DATABASE_URL_SESSION is the Session pooler string (port 5432), for DDL tooling only. Never a
# Direct connection (IPv6-only on the free tier). Migrations are applied through Supabase.
# SUPABASE_SECRET_KEY is a modern secret key (sb_secret_...) from the project's API settings, server-only, for
# Storage (the private media bucket). It rotates on its own; the legacy service_role key cannot and is not read.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_SESSION=

# --- Dynamic (auth, two embedded wallets per user) ---
# Sandbox environment with embedded wallets enabled. Monad testnet is not a dashboard toggle;
# it is registered in code through an evmNetworks override in the SDK config (Phase 1).
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# --- Alchemy / Monad ---
# No NEXT_PUBLIC_ prefix on purpose: this URL carries the Alchemy API key and must stay server-only.
MONAD_RPC_URL=
# 10143 = Monad testnet (through submission). 143 = Monad mainnet (post-submission).
MONAD_CHAIN_ID=

# --- Relayer ---
# One server-controlled EOA that pays gas and nothing else. It holds no user keys and cannot
# originate an action; it forwards messages users have signed. Generate with `cast wallet new`.
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=

# --- Phone hash salt ---
# Permanent. Once one hash is stored it can never change.
PHONE_HASH_SALT=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional. Defaults are in src/lib/ai/client.ts.
AI_MODEL_DRAFTING=
AI_MODEL_RULING=

# --- Contracts ---
# Filled after the Foundry deploy. Read from environment everywhere, never hardcoded.
DAREFUL_LEDGER_ADDRESS=
DAREFUL_DARES_ADDRESS=

# --- Envio ---
# Local GraphQL endpoint served by `npm run indexer:dev` (Hasura on port 8080).
# ENVIO_API_TOKEN is optional until HyperSync is used; create one at https://envio.dev/app/api-tokens.
ENVIO_API_TOKEN=
# Local default: http://localhost:8080/v1/graphql
ENVIO_GRAPHQL_URL=

# --- Seed (scripts/seed.ts, Phase 0) ---
# BIP-39 mnemonic that seed users' ledger and governance wallets derive from, so re-runs are
# idempotent. Test-only; these wallets hold nothing but non-transferable records.
# Generate with `cast wallet new-mnemonic`.
SEED_MNEMONIC=

# --- Optional ---
# Set to 1 to print the declared limit and receipt status for every relayer transaction. Monad receipts report
# gasUsed equal to the limit, so this only shows whether a limit was enough; calibrate with scripts/gas-survey.ts.
RELAYER_LOG_GAS=

# --- Client-side chain facts (no secrets; the browser needs them for the Dynamic SDK network entry) ---
# 10143 through submission. The public RPC is what the wallet SDK reads balances through; it carries no key.
NEXT_PUBLIC_MONAD_CHAIN_ID=
NEXT_PUBLIC_MONAD_PUBLIC_RPC_URL=
NEXT_PUBLIC_MONAD_EXPLORER_URL=

# --- Session ---
# Signs the httpOnly session cookie the server issues after verifying a Dynamic login token. Rotating it logs everyone out.
SESSION_SECRET=

# Absolute origin for links the app hands to the composer (invites, shares). https://dareful.app in production.
NEXT_PUBLIC_APP_URL=

# Web Push (VAPID). Generate once with: npx web-push generate-vapid-keys. The public key is inlined at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Transactional email (Resend). EMAIL_FROM is a sender on a domain verified in Resend, e.g. Dareful <hello@dareful.app>.
# Addresses are read from Dynamic at send time with DYNAMIC_API_TOKEN and never stored.
# Read-only Dynamic API token, server-only: reads a login email at send time, and nothing else.
DYNAMIC_API_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=
# Where the scheduler writes when the relayer's balance is under its floor (src/lib/chain/watch.ts). Off when blank.
OPS_EMAIL=

# The scheduler. The database (pg_cron + pg_net) POSTs to /api/tick once a minute with this as a bearer token.
# The same value lives in Supabase Vault as `dareful_tick_secret`. Rotate both together.
TICK_SECRET=
